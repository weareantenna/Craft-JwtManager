{% extends '_layouts/cp' %}

{% import '_includes/forms' as forms %}

{% set fullPageForm = true %}

{% block content %}
    <input type="hidden" name="action" value="jwt-manager/jwts/save">
    {{ redirectInput('jwt-manager/jwts') }}

    <input type="hidden" name="jwtId" value="{{ jwtId ?? "" }}">

    {{ forms.selectField({
        label: "Type"|t('app'),
        instructions: "What this JWT will be used for."|t('jwt-manager'),
        id: 'type',
        name: 'type',
        options: jwtTypes,
        value: jtw is defined ? jwt.type : "",
        errors: jwt.getErrors('type'),
        required: true,
        first: true,
    }) }}

    {{ forms.elementSelectField({
        label: "User"|t('app'),
        id: 'userId',
        name: 'userId',
        elementType: 'craft\\elements\\User',
        selectionLabel: "Choose"|t('app'),
        limit: 1,
        elements: not brandNewJwt ? [craft.users.id(jwt.userId).one()] : [],
        errors: jwt.getErrors('userId')
    }) }}
{% endblock %}
